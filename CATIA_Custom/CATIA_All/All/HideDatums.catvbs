Language="VBSCRIPT"

Sub CATMain()

Set drawingDocument1 = CATIA.ActiveDocument

Set selection1 = drawingDocument1.Selection

Set visPropertySet1 = selection1.VisProperties

Set drawingSheets1 = drawingDocument1.Sheets

Set drawingSheet1 = drawingSheets1.ActiveSheet

'Set drawingSheet1 = drawingSheets1.Item("BL04")

Set drawingViews1 = drawingSheet1.Views

'Set drawingView1 = drawingViews1.Item("Front view")

Set drawingView1 = drawingViews1.ActiveView


Set geometricElements1 = drawingView1.GeometricElements

Set axis2D1 = geometricElements1.Item("AbsoluteAxis")

Set line2D1 = axis2D1.GetItem("HDirection")

Set axis2D1 = line2D1.Parent

Dim bSTR1
bSTR1 = line2D1.Name

Dim bSTR2
bSTR2 = axis2D1.Name

Dim bSTR3
bSTR3 = line2D1.Name

Set geometricElements1 = axis2D1.Parent

Dim bSTR4
bSTR4 = axis2D1.Name

selection1.Add line2D1

Set visPropertySet1 = visPropertySet1.Parent

Dim bSTR5
bSTR5 = visPropertySet1.Name

Dim bSTR6
bSTR6 = visPropertySet1.Name

visPropertySet1.SetShow 1

selection1.Clear 

Set selection2 = drawingDocument1.Selection

Set visPropertySet2 = selection2.VisProperties

Set line2D2 = axis2D1.GetItem("VDirection")

Set axis2D1 = line2D2.Parent

Dim bSTR7
bSTR7 = line2D2.Name

Dim bSTR8
bSTR8 = axis2D1.Name

Dim bSTR9
bSTR9 = line2D2.Name

Set geometricElements1 = axis2D1.Parent

Dim bSTR10
bSTR10 = axis2D1.Name

selection2.Add line2D2

Set visPropertySet2 = visPropertySet2.Parent

Dim bSTR11
bSTR11 = visPropertySet2.Name

Dim bSTR12
bSTR12 = visPropertySet2.Name

visPropertySet2.SetShow 1

selection2.Clear 

Set selection3 = drawingDocument1.Selection

Set visPropertySet3 = selection3.VisProperties

Set point2D1 = axis2D1.GetItem("Origin")

Set axis2D1 = point2D1.Parent

Dim bSTR13
bSTR13 = point2D1.Name

Dim bSTR14
bSTR14 = axis2D1.Name

Dim bSTR15
bSTR15 = point2D1.Name

Set geometricElements1 = axis2D1.Parent

Dim bSTR16
bSTR16 = axis2D1.Name

selection3.Add point2D1

Set visPropertySet3 = visPropertySet3.Parent

Dim bSTR17
bSTR17 = visPropertySet3.Name

Dim bSTR18
bSTR18 = visPropertySet3.Name

visPropertySet3.SetShow 1

selection3.Clear 

End Sub
