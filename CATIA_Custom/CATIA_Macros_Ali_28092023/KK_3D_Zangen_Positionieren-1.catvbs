 If (status = "Cancel") Then Exit Sub
 
'********selektierte Achsen zur selektion addieren
     Set SelectedAxis(AxisIndex) = selection1.Item2(AxisIndex + 1).Value: SelectedAxisCount = SelectedAxisCount + 1
