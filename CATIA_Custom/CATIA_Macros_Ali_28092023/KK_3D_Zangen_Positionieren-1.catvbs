 If (status = "Cancel") Then Exit Sub
 
 

'********selektierte Achsen zur selektion addieren

        'folderinput_1 = oActiveDoc.Path + "\" + oActiveDoc.PRODUCT.Products.Item(2).PartNumber + ".CATProduct"
    folderinput_1 = oActiveDoc.Path + "\" + oPart_2 + ".CATProduct"

 For AxisIndex1 = 0 To selection1.Count2 - 1

     Set SelectedAxis(AxisIndex1) = selection1.Item2(AxisIndex1 + 1).Value: SelectedAxisCount = SelectedAxisCount + 1
 
 
        'Set product1 = oActiveDoc.PRODUCT
